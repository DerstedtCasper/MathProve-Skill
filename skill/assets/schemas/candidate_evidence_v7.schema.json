{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathProve v7 candidate evidence",
  "type": "object",
  "required": [
    "candidate_id",
    "stage",
    "role",
    "artifact_paths"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "intake",
        "notation",
        "blueprint",
        "skeleton",
        "line_map",
        "lemma_sprint",
        "refutation",
        "integration",
        "final_audit"
      ]
    },
    "role": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lean_passed": {
      "type": "boolean"
    },
    "sympy_passed": {
      "type": "boolean"
    },
    "no_sorry": {
      "type": "boolean"
    },
    "dependency_closure": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "refutation_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maintainability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "restartability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "veto_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}