{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:mathprove:v9:plan",
  "required": [
    "spec_hash",
    "target",
    "nodes",
    "literature"
  ],
  "properties": {
    "spec_hash": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "literature": {
      "type": "object"
    }
  }
}
